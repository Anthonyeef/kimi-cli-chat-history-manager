# Kimi Chat History API Configuration

# Server settings
HOST=127.0.0.1
PORT=8001

# CORS settings (allow local file access for dashboard)
CORS_ORIGINS=["http://localhost:8001", "null", "file://"]

# Kimi data paths
KIMI_BASE_DIR=~/.kimi

# Caching
CACHE_TTL=300
AUTO_REFRESH_INTERVAL=300

# Logging
LOG_LEVEL=INFO

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Truncation
MAX_CHAT_NAME_LENGTH=50
MAX_MESSAGE_PREVIEW=100
MAX_DETAIL_MESSAGES=1000
